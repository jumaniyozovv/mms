generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum DayOffType {
  PAID
  SICK
  PERSONAL
}

enum DayOffStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String  @map("phone")
  role      UserRole @default(USER)
  paidDaysOff     Int @default(15) @map("paid_days_off")
  sickDaysOff     Int @default(5) @map("sick_days_off")
  personalDaysOff Int @default(10) @map("personal_days_off")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dayOffs         DayOff[] @relation("UserDayOffs")
  approvedDayOffs DayOff[] @relation("ApprovedDayOffs")


  assignedTasks Task[] @relation("AssignedTasks")

  @@map("users")
}

model DayOffConfig {
  id              String @id @default(cuid())
  paidDaysOff     Int    @default(15) @map("paid_days_off")
  sickDaysOff     Int    @default(5) @map("sick_days_off")
  personalDaysOff Int    @default(10) @map("personal_days_off")

  @@map("day_off_config")
}

model DayOff {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  type         DayOffType
  status       DayOffStatus @default(PENDING)
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at")
  approvedAt   DateTime?    @map("approved_at")
  approvedById String?      @map("approved_by_id")

  user       User  @relation("UserDayOffs", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("ApprovedDayOffs", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("day_offs")
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

/*  TASKS ENUM  */

enum TaskType {
  TASK
  BUG
  FEATURE
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  PAUSED
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
model Task {
  id          String      @id @default(uuid())
  key         String       @unique   // e.g. "MMS-14" — stored, never recomputed
  title       String
  description String?
  type        TaskType
  status      TaskStatus  @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId  String?
  assignee    User? @relation("AssignedTasks", fields: [assigneeId], references: [id])

  projectId   String      @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  githubUrl   String?       @map("github_url")
  status      ProjectStatus @default(ACTIVE)

  prefix      String        @unique   // e.g. "MMS" — short, uppercase, used in task keys
  taskCounter Int           @default(0) @map("task_counter") // last number issued, increments only


  tasks       Task[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}